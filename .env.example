# 环境配置
NODE_ENV=development
PORT=5000

# 数据库配置
DB_MODE=mongo
MONGODB_URI=mongodb://localhost:27017/environment_db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=environment_site
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# JWT配置
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_2026
JWT_EXPIRE=7d

# 前端URL
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# 服务器配置
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# 登录风控（IP 级别）
AUTH_FAIL_WINDOW=900000
AUTH_FAIL_MAX=5
AUTH_FAIL_BLOCK=900000

# 日志配置
LOG_LEVEL=info

# SMTP 配置（用于审核通知邮件）
SMTP_HOST=smtp.example.edu.cn
SMTP_PORT=465
SMTP_USER=your_account@example.edu.cn
SMTP_PASS=your_email_password
SMTP_FROM=Research Platform <your_account@example.edu.cn>
